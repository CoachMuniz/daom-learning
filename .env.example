# ==============================================================================
# DAOM Learning — Variables de Entorno (Canario DAOM-FORMACION-SHEET-01)
# ==============================================================================

# Entorno y URLs
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Fuente de Verdad Editorial — Google Sheet
# Sheet: DAOM_Learning_Contenido_ET3
GOOGLE_SHEET_ID=1LlUzvMbEoJ4-ATmecOCyRBgy19Hrib4cdkpyLaspjI4
TIMEZONE=America/Argentina/Buenos_Aires

# Base de Datos
# Dejar vacío o no definir para usar SQLite embebido local/test.
# Para PostgreSQL / Supabase, definir DATABASE_URL:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require
# PG_CA_CERT=
# PG_REJECT_UNAUTHORIZED=true

# Seguridad y Autenticación
# Clave secreta para firmar tokens de sesión JWT (mínimo 32 caracteres)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_daom_2026
ADMIN_EMAIL=admin@daom-weightlifting.com
ADMIN_INITIAL_PASSWORD=DaomLearning2026!Secure

# Contrato de Integración con el Bot (API v1)
# Clave para autenticación entre servicios (Server-to-Server)
BOT_API_SECRET_KEY=daom_bot_integration_key_secret_2026_secure

# Token para forzar sincronización manual vía endpoint /api/sync/sheets
SYNC_SECRET_TOKEN=daom_sync_trigger_secret_token_2026

# Almacenamiento Privado de Materiales Complementarios (ZIP)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/materials
# Si se usa Supabase Storage:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=materials
